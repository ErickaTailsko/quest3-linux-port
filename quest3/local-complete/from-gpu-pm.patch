+		pr_err("quest_kexec: use one SCM mutation per load, without execution/reset/physical tests\n");
+		return -EINVAL;
+	}
 	if (test_cpus > 2 || preflight_only > 3 || core_hang_control > 2 ||
 	    secure_watchdog_control > 2 || phase_delay_ms > 5000 ||
