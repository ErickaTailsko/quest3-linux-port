+++ b/module/quest3-scm.h
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef QKX_QUEST3_SCM_H
+#define QKX_QUEST3_SCM_H
+int qkx_core_hang_configure(unsigned int mode);
+int qkx_secure_watchdog_configure(unsigned int mode);
+#endif
